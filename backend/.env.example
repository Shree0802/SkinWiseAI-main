# SkinWise AI - Backend Environment Variables
APP_NAME=SkinWise AI
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1

# YouCam Skin AI API (Perfect Corp S2S Enterprise API)
# Obtain your API key from Perfect Corp YouCam developer portal (https://docs.makeupar.com)
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_POLL_INTERVAL=1.5
YOUCAM_POLL_TIMEOUT=60

# Set to True for local development/offline testing without an API key. Set to False in production.
ALLOW_DEMO_FALLBACK=False

# Database Configuration
# Local development: sqlite:///./skinwise.db
# Production (Render / Neon PostgreSQL): postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./skinwise.db

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=https://skin-wise-ai-main.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
